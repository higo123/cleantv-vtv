diff --git a/launcher/app/src/main/java/com/gathin/tvhome/HomeLock.java b/launcher/app/src/main/java/com/gathin/tvhome/HomeLock.java
new file mode 100644
index 0000000..52e047d
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/HomeLock.java
@@ -0,0 +1,98 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.widget.Toast;
+
+import org.json.JSONObject;
+
+/** CleanTV/VGS: app khoá (locked_apps trong config.json) chỉ bỏ khỏi Home được sau khi nhập mã (lock_pin). */
+final class HomeLock {
+    private HomeLock() { }
+
+    static boolean isLocked(Activity a, String pkg) {
+        JSONObject j = Weather.cauHinh(a);
+        if (j == null) return false;
+        for (String p : j.optString("locked_apps", "").split("[,;\\s]+")) if (!p.isEmpty() && p.equals(pkg)) return true;
+        return false;
+    }
+
+    /** Gói bị khoá theo thứ tự trong config (cũng là thứ tự vị trí đầu hàng). */
+    static java.util.List<String> lockedList(Activity a) {
+        java.util.List<String> out = new java.util.ArrayList<>();
+        JSONObject j = Weather.cauHinh(a);
+        if (j == null) return out;
+        for (String p : j.optString("locked_apps", "").split("[,;\\s]+")) if (!p.isEmpty()) out.add(p);
+        return out;
+    }
+
+    /** Đưa các tile khoá lên đầu (theo thứ tự config), còn lại giữ thứ tự. keys có dạng "gói/lớp". */
+    static java.util.List<String> lockedFirst(Activity a, java.util.List<String> keys) {
+        java.util.List<String> locked = lockedList(a);
+        if (locked.isEmpty()) return keys;
+        java.util.List<String> out = new java.util.ArrayList<>();
+        for (String p : locked) for (String k : keys) if (k.startsWith(p + "/") && !out.contains(k)) out.add(k);
+        for (String k : keys) if (!out.contains(k)) out.add(k);
+        return out;
+    }
+
+    /** Hỏi mã bằng bàn phím số tự vẽ (chọn bằng phím mũi tên + OK, hoặc bấm số trên remote); đúng mới chạy onOk. */
+    static void confirm(Activity a, Runnable onOk) {
+        JSONObject j = Weather.cauHinh(a);
+        final String pin = j == null ? "123456" : j.optString("lock_pin", "123456");
+        final float dp = a.getResources().getDisplayMetrics().density;
+        final StringBuilder typed = new StringBuilder();
+        android.widget.LinearLayout root = new android.widget.LinearLayout(a);
+        root.setOrientation(android.widget.LinearLayout.VERTICAL);
+        root.setPadding((int) (24 * dp), (int) (16 * dp), (int) (24 * dp), (int) (8 * dp));
+        final android.widget.TextView show = new android.widget.TextView(a);
+        show.setTextSize(30);
+        show.setGravity(android.view.Gravity.CENTER);
+        show.setPadding(0, (int) (8 * dp), 0, (int) (12 * dp));
+        root.addView(show);
+        AlertDialog d = new AlertDialog.Builder(a).setTitle("Nhập mã để xóa hoặc di chuyển").setView(root)
+                .setNegativeButton("Hủy", null).create();
+        final Runnable[] refresh = new Runnable[1];
+        refresh[0] = () -> {
+            StringBuilder s2 = new StringBuilder();
+            for (int k = 0; k < pin.length(); k++) s2.append(k < typed.length() ? "● " : "○ ");
+            show.setText(s2.toString().trim());
+        };
+        final Runnable[] check = new Runnable[1];
+        check[0] = () -> {
+            if (typed.toString().equals(pin)) { d.dismiss(); onOk.run(); }
+            else { typed.setLength(0); refresh[0].run(); Toast.makeText(a, "Sai mã", Toast.LENGTH_SHORT).show(); }
+        };
+        final java.util.function.IntConsumer press = n -> {
+            if (n == -1) { if (typed.length() > 0) typed.setLength(typed.length() - 1); }
+            else if (typed.length() < pin.length()) typed.append(n);
+            refresh[0].run();
+            if (n >= 0 && typed.length() == pin.length()) check[0].run();
+        };
+        int[][] rows = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}, {-1, 0, -2}};
+        android.widget.Button first = null;
+        for (int[] row : rows) {
+            android.widget.LinearLayout line = new android.widget.LinearLayout(a);
+            for (int n : row) {
+                android.widget.Button b = new android.widget.Button(a);
+                b.setText(n == -1 ? "Xóa" : n == -2 ? "OK" : String.valueOf(n));
+                b.setTextSize(22);
+                b.setFocusable(true);
+                b.setOnClickListener(v -> { if (n == -2) check[0].run(); else press.accept(n); });
+                line.addView(b, new android.widget.LinearLayout.LayoutParams((int) (88 * dp), (int) (60 * dp)));
+                if (first == null) first = b;
+            }
+            root.addView(line);
+        }
+        d.setOnKeyListener((dlg, code, ev) -> {
+            if (ev.getAction() != android.view.KeyEvent.ACTION_DOWN) return false;
+            if (code >= android.view.KeyEvent.KEYCODE_0 && code <= android.view.KeyEvent.KEYCODE_9) { press.accept(code - android.view.KeyEvent.KEYCODE_0); return true; }
+            if (code >= android.view.KeyEvent.KEYCODE_NUMPAD_0 && code <= android.view.KeyEvent.KEYCODE_NUMPAD_9) { press.accept(code - android.view.KeyEvent.KEYCODE_NUMPAD_0); return true; }
+            if (code == android.view.KeyEvent.KEYCODE_DEL) { press.accept(-1); return true; }
+            return false;
+        });
+        refresh[0].run();
+        d.show();
+        if (first != null) first.requestFocus();
+    }
+}
