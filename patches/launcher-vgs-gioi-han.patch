diff --git a/launcher/app/src/main/java/com/gathin/tvhome/HomeLock.java b/launcher/app/src/main/java/com/gathin/tvhome/HomeLock.java
new file mode 100644
index 0000000..a405ee4
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/HomeLock.java
@@ -0,0 +1,63 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * CleanTV/VGS: các app trong locked_apps (config.json) bị khoá cứng ở đầu hàng: không bỏ khỏi Home, không di chuyển,
+ * và có ổ khoá nhỏ trên icon.
+ */
+final class HomeLock {
+    private HomeLock() { }
+
+    /** Gói bị khoá theo thứ tự trong config (cũng là thứ tự vị trí đầu hàng). */
+    static List<String> lockedList(Context c) {
+        List<String> out = new ArrayList<>();
+        JSONObject j = Weather.cauHinh(c);
+        if (j == null) return out;
+        for (String p : j.optString("locked_apps", "").split("[,;\\s]+")) if (!p.isEmpty()) out.add(p);
+        return out;
+    }
+
+    static boolean isLocked(Context c, String pkg) {
+        return pkg != null && lockedList(c).contains(pkg);
+    }
+
+    /** Đưa các tile khoá lên đầu (theo thứ tự config), còn lại giữ thứ tự. keys có dạng "gói/lớp". */
+    static List<String> lockedFirst(Context c, List<String> keys) {
+        List<String> locked = lockedList(c);
+        if (locked.isEmpty()) return keys;
+        List<String> out = new ArrayList<>();
+        for (String p : locked) for (String k : keys) if (k.startsWith(p + "/") && !out.contains(k)) out.add(k);
+        for (String k : keys) if (!out.contains(k)) out.add(k);
+        return out;
+    }
+
+    /** Ổ khoá nhỏ ở góc trên phải của ô; tạo một lần rồi chỉ bật/tắt. */
+    static void badge(ViewGroup card, boolean locked) {
+        View old = card.findViewWithTag("lockbadge");
+        if (old == null && !locked) return;
+        if (old == null) {
+            float dp = card.getResources().getDisplayMetrics().density;
+            ImageView v = new ImageView(card.getContext());
+            v.setTag("lockbadge");
+            v.setImageResource(R.drawable.ic_lock_small);
+            v.setFocusable(false);
+            v.setClickable(false);
+            FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams((int) (16 * dp), (int) (16 * dp), Gravity.TOP | Gravity.END);
+            lp.setMargins(0, (int) (5 * dp), (int) (5 * dp), 0);
+            card.addView(v, lp);
+            old = v;
+        }
+        old.setVisibility(locked ? View.VISIBLE : View.GONE);
+    }
+}
